datasource db {
  provider = "sqlite"
}

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
}

model Farm {
  id          Int      @id @default(autoincrement())
  name        String
  address     String
  gridX       Int
  gridY       Int
  totalArea   Float
  actualArea  Float
  crops       Crop[]
  createdAt   DateTime @default(now())
}

model Crop {
  id            Int       @id @default(autoincrement())
  farmId        Int
  farm          Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name          String
  status        String    // "PLANTED" or "PLANNED"
  plantingDate  DateTime?
  bloomDate     DateTime?
  harvestDate   DateTime?
  baseTemp      Float     @default(10.0)
  targetGdd     Float     @default(1500.0)
  expectedYield Float?
  logs          FarmLog[]
  createdAt     DateTime  @default(now())
}

model FarmLog {
  id        Int      @id @default(autoincrement())
  cropId    Int
  crop      Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  date      DateTime
  workType  String
  stage     String
  memo      String
  avgTemp   Float?
  createdAt DateTime @default(now())
}